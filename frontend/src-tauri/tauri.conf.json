{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CryptoEdge",
  "version": "20.37.0",
  "identifier": "com.cryptoedge.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CryptoEdge — Control Room",
        "width": 1600,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:47821 ws://127.0.0.1:47822; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
